{
  "name": "@matr1xp/ui",
  "version": "0.1.0",
  "description": "Shared React Native UI components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matr1xp/rnStorybook.git",
    "directory": "packages/ui"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "matr1xp-ui-source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "!**/*.stories.*",
    "!**/__tests__"
  ],
  "scripts": {
    "prepare": "bob build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.81.6",
    "@storybook/react-native": "^10.6.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "react-native-builder-bob": "^0.43.2",
    "storybook": "^10.6.2",
    "typescript": "^5.8.3"
  }
}
